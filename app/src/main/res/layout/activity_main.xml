<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="QSO Logger"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="20dp"/>

    <EditText
        android:id="@+id/etCall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Позывной (например, UW5ENT)"
        android:inputType="textCapCharacters" />

    <EditText
        android:id="@+id/etBand"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Диапазон (например, 20m)"
        android:inputType="text" />

    <EditText
        android:id="@+id/etMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Модуляция (например, SSB)"
        android:inputType="textCapCharacters" />

    <Button
        android:id="@+id/btnSave"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Сохранить QSO"
        android:layout_marginTop="20dp"/>

</LinearLayout>
